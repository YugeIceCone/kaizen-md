{
  "mcpServers": {
    "kaizen-backlog": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/mcp_server.py"]
    },
    "kaizen-browser": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/browser_mcp.py"
      ]
    },
    "kaizen-trace-search": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/trace_mcp.py"
      ]
    },
    "kaizen-knowledge-search": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/knowledge_mcp.py"
      ]
    },
    "kaizen-onboard-search": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/onboard_mcp.py"
      ]
    }
  }
}
