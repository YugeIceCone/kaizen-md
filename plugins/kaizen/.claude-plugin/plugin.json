{
  "name": "kaizen",
  "version": "1.25.3",
  "description": "Consistent git commit discipline — pre-commit gate, micro-work backlog (JSON-sourced), sizing by trace+sem+grep, brain-sourced behaviour rules. Ships 3 agents (reviewer/curator/debt-auditor) with worktree isolation, hash-keyed cache, statusline, context-window awareness, language-agnostic docs generator, async Node+Flow demo, and non-blocking message inbox (UserPromptSubmit→PostToolUse) so Claude sees user input on every tool boundary. Self-contained: bundles 35 skills (tdd + 9 coding-skills + onion-ddd-workflow + 14 superpowers + workflow-routing + 5 remember/Second Brain + plugin-pitfalls + behaviour-config + publishing) plus all supporting scripts/refs/assets. No external plugin dependencies.",
  "author": {
    "name": "YugeIceCone",
    "url": "https://github.com/YugeIceCone"
  },
  "homepage": "https://github.com/YugeIceCone/kaizen-md",
  "repository": "https://github.com/YugeIceCone/kaizen-md",
  "license": "MIT",
  "keywords": [
    "git",
    "pre-commit",
    "workflow",
    "backlog",
    "discipline",
    "coding-skills",
    "onion-ddd",
    "tdd",
    "ddd",
    "clean-architecture",
    "hexagonal",
    "kiss",
    "yagni",
    "dry",
    "solid"
  ],
  "permissions": {
    "allow": [
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/backlog.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/rules.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/cache.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/mcp_server.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/flow_demo.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/knowledge_index.py:*)",
      "Bash(uv run --script ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/knowledge_mcp.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/onboard_index.py:*)",
      "Bash(uv run --script ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/onboard_mcp.py:*)",
      "Bash(uv run --script ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/scrape_index.py:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/workflow-routing/scripts/workflow_runner.py:*)",
      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/*.sh:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/kaizen/scripts/config.py:*)",
      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/skills/workflow-routing/scripts/*.sh:*)",
      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/hooks/*.sh:*)",
      "Bash(node ${CLAUDE_PLUGIN_ROOT}/scripts/*.js:*)",
      "Read(${CLAUDE_PLUGIN_ROOT}/**)",
      "Read(.kaizen/**)",
      "Read(.workflow/**)",
      "Read(.kaizen.toml)",
      "Write(.kaizen/cache/**)"
    ]
  }
}
