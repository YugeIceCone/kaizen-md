      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/skills/workflow/scripts/*.sh:*)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/workflow/scripts/config.py:*)",
      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/hooks/*.sh:*)",
      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/hooks/claude/*.sh:*)",
      "Bash(node ${CLAUDE_PLUGIN_ROOT}/scripts/*.js:*)",
      "Read(${CLAUDE_PLUGIN_ROOT}/**)",
      "Read(.kaizen/**)",
      "Read(.workflow/**)",
      "Read(.kaizen.toml)",
      "Write(.kaizen/cache/**)",
      "Bash(python3 ${CLAUDE_PLUGIN_ROOT}/skills/workflow/scripts/run_tests_parallel.py:*)",
      "Bash(bash ${CLAUDE_PLUGIN_ROOT}/bin/kaizen-run-tests-parallel:*)"
    ]
  }
}
