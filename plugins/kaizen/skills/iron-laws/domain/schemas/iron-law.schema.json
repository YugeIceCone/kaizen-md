{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kaizen iron-laws registry",
  "description": "Schema for skills/iron-laws/domain/iron-laws.yaml — the single source of truth for the kaizen plugin's iron laws.",
  "type": "object",
  "required": ["version", "laws"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "laws": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "severity", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["hard", "soft", "info"] },
          "detect": { "type": "string" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
