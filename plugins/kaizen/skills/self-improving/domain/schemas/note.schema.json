{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen.invalid/self-improving/schemas/note.schema.json",
  "title": "Brain Note frontmatter",
  "description": "Validates the YAML frontmatter of ~/.claude/brain/Notes/*.md files. Belief notes (pref-*.md) follow this schema; non-pref notes may relax constraints.",
  "type": "object",
  "required": ["created", "type"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "created": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    },
    "updated": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    },
    "type": {
      "enum": ["belief", "feedback", "audit", "project", "session", "world-fact", "reference", "user", "system", "persona", "observation", "behaviour"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "sources_count": {
      "type": "integer",
      "minimum": 0
    },
    "freshness": {
      "enum": ["fresh", "stable", "hardened", "stale", "archived"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "date"],
        "properties": {
          "source": { "type": "string" },
          "quote": { "type": "string" },
          "date": { "type": "string" },
          "context": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
