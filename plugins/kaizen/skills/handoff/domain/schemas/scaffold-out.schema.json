{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YugeIceCone/kaizen-md/skills/handoff/scaffold-out.schema.json",
  "title": "Handoff scaffold output",
  "description": "Records what was prefilled and what the agent still has to write. The yaml_path file is the system of record.",
  "type": "object",
  "required": ["yaml_path", "prefilled_sections", "agent_must_fill", "stats"],
  "additionalProperties": false,
  "properties": {
    "yaml_path":          { "type": "string" },
    "session":            { "type": "string" },
    "prefilled_sections": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Section names the scaffold filled mechanically."
    },
    "agent_must_fill": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Section names left empty — agent must Edit them in."
    },
    "stats": {
      "type": "object",
      "required": ["commits_since", "files_changed", "since"],
      "additionalProperties": false,
      "properties": {
        "commits_since":   { "type": "integer", "minimum": 0 },
        "files_changed":   { "type": "integer", "minimum": 0 },
        "since":           { "type": "string" }
      }
    },
    "mined_from_session": {
      "type": "boolean",
      "description": "True when the active Claude Code session JSONL was discovered AND mined for pre-fill data."
    },
    "session_jsonl": {
      "type": "string",
      "description": "Path to the session JSONL that was mined (when mined_from_session is true)."
    },
    "mined_summary": {
      "type": "object",
      "description": "Summary of what was mined from the session.",
      "additionalProperties": true,
      "properties": {
        "ai_title":           { "type": ["string", "null"] },
        "completed_count":    { "type": "integer", "minimum": 0 },
        "pending_count":      { "type": "integer", "minimum": 0 },
        "files_touched":      { "type": "integer", "minimum": 0 },
        "skills_used":        { "type": "array", "items": { "type": "string" } },
        "session_started_at": { "type": ["string", "null"] }
      }
    }
  }
}
