{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YugeIceCone/kaizen-md/skills/handoff/scaffold-in.schema.json",
  "title": "Handoff scaffold input",
  "type": "object",
  "required": ["session", "goal", "now"],
  "additionalProperties": false,
  "properties": {
    "session":           { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "goal":              { "type": "string", "maxLength": 240 },
    "now":               { "type": "string", "maxLength": 240 },
    "description_slug":  { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "since":             { "type": "string", "description": "Git --since filter (YYYY-MM-DD or relative)." },
    "at":                { "type": "string", "description": "Override UTC timestamp (YYYY-MM-DD_HH-MM) — testing aid." }
  }
}
