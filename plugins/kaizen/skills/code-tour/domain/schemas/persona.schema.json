{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen.invalid/code-tour/schemas/persona.schema.json",
  "title": "Code-tour personas catalog",
  "type": "object",
  "required": ["personas"],
  "additionalProperties": false,
  "properties": {
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "goal", "must_cover", "default_depth"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "goal": { "type": "string", "minLength": 1 },
          "must_cover": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "default_depth": { "enum": ["quick", "standard", "deep"] },
          "trigger_phrases": { "type": "array", "items": { "type": "string" } },
          "is_default": { "type": "boolean" }
        }
      }
    }
  }
}
