#!/usr/bin/env bash
# kaizen-stop-self-improving-review — periodic memory-curation nudge.
set -euo pipefail
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || { echo "kaizen-stop-self-improving-review: plugin root unresolved" >&2; exit 1; }
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/stop_self_improving_review.py" "$@"
