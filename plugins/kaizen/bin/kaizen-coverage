#!/usr/bin/env bash
# Mechanical 1:1 code-to-test mapper (summary | gaps | report).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/scripts/quality/coverage.py" "$@"
