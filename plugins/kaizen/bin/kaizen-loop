#!/usr/bin/env bash
# kaizen-loop — controlled read/write of .kaizen/loop.state.md.
# Symlinked to ~/.local/bin/kaizen-loop by /kaizen:install.
#
# Backed by ${PLUGIN_ROOT}/skills/workflow/scripts/loop_state.py. See
# `kaizen-loop --help` for subcommands (add / list / status / complete / cancel).
#
# Use this (or the kaizen-loop MCP tools) instead of hand-editing
# .kaizen/loop.state.md. The script validates schema + auto-IDs items +
# refuses to manually complete verify-bearing items (those must pass the
# hook's verify gate, which is the cheat-proof completion path).
#
# NOT to be confused with /kaizen:loop (the slash command that STARTS a
# loop) — this binary operates on the state of an already-running loop.

set -euo pipefail

# Resolve real script location through any symlinks so $_BIN_DIR points at
# the actual plugin bin dir, not ~/.local/bin/ (where /kaizen:install drops
# the symlink). Without realpath resolution, the ../skills/... source fails.
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-loop: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/loop_state.py" "$@"
