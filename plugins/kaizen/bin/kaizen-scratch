#!/usr/bin/env bash
# kaizen-scratch — tight specialized sandbox for one-off debug ops.
# Avoids the "cd /tmp && rm -rf .git" gate-trip pattern by always
# operating under /tmp/kaizen-scratch/ (matches _RM_RF_SAFE).
# See scripts/util/scratch.py for the full docstring.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-scratch: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/scripts/util/scratch.py" "$@"
