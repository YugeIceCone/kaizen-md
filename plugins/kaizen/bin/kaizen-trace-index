#!/usr/bin/env bash
# SQLite-backed semantic search over kaizen trace events.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)

# Use uv to handle the PEP 723 inline-script-metadata deps (sentence-transformers + numpy)
if command -v uv >/dev/null 2>&1; then
    exec uv run --script "$PLUGIN_ROOT/skills/kaizen/scripts/trace_index.py" "$@"
else
    exec python3 "$PLUGIN_ROOT/skills/kaizen/scripts/trace_index.py" "$@"
fi
