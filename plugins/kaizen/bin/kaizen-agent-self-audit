#!/usr/bin/env bash
# kaizen-agent-self-audit — agent-driven follow-up to the mechanical
# self-audit. Renders subagent briefs (dispatch-plan) and merges their
# results (aggregate).
#
# Canonical CLI name — aligns with /kaizen:agent-self-audit slash.
# bin/kaizen-self-audit-agent kept as a deprecation alias (forwards here).
#
# Subcommands: dispatch-plan [--json] | aggregate [--run-id ID] [--json] | path
# See skills/plugin-self-audit/SKILL.md for the full three-phase flow.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../scripts/util/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-agent-self-audit: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/scripts/iron-laws/self_audit_agent.py" "$@"
