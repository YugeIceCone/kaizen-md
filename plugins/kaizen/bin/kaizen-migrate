#!/usr/bin/env bash
# kaizen-migrate — consolidated data-migrator dispatcher.
# Dispatches:
#   kaizen-migrate path   → path_migrate.py (v1.38 → v1.39 layout)
#   kaizen-migrate legacy → migrate_paths.sh (v1.21 → v1.22 layout)
# Brain migration lives under `kaizen-brain migrate` (single-surface).
# Code-lift engine moved to `kaizen-code-lift` (Tier-2 commit A).

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-migrate: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/migrate.py" "$@"
