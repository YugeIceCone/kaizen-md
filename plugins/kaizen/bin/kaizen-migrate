#!/usr/bin/env bash
# kaizen-migrate — transitional. Points at code_lift.py since _migrate.py
# was renamed in Tier-2 commit A. Commit B replaces this wrapper with the
# new data-migrator dispatcher (path | legacy). Until then, callers of
# `kaizen-migrate` keep getting the code-lift engine via the renamed path.
#
# After commit B lands, use `kaizen-code-lift` for the code-lift engine and
# `kaizen-migrate <path|legacy>` for the data-migrator dispatcher.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-migrate: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/code_lift.py" "$@"
