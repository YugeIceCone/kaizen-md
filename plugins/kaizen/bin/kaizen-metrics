#!/usr/bin/env bash
# kaizen-metrics — rollup + never-used + skip-detection over the trace log.
# Symlinked to ~/.local/bin/kaizen-metrics by /kaizen:install.
#
# Subcommands: session | lifetime | never-used | top | skips | path
# See metrics.py docstring for full surface.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-metrics: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/metrics.py" "$@"
