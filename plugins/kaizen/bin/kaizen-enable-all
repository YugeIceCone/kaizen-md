#!/usr/bin/env bash
# kaizen-enable-all — one-shot setup for kaizen (project + curated globals).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec bash "$PLUGIN_ROOT/skills/workflow/scripts/enable_all.sh" "$@"
