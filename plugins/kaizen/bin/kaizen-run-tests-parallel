#!/usr/bin/env bash
# kaizen-run-tests-parallel — bin wrapper for the async-bounded-batch
# parallel test runner. See run_tests_parallel.py for details.
set -euo pipefail
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../scripts/util/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || { echo "kaizen-run-tests-parallel: plugin root unresolved" >&2; exit 1; }
exec python3 "$PLUGIN_ROOT/scripts/tests/run_tests_parallel.py" "$@"
