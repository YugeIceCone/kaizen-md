#!/usr/bin/env bash
# kaizen-knowledge-mcp — MCP server exposing semantic search over the knowledge index.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec uv run --script "$PLUGIN_ROOT/skills/kaizen/scripts/knowledge_mcp.py" "$@"
