#!/usr/bin/env bash
# kaizen-yaml — read-only YAML aggregator over plugin configs.
set -euo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/kaizen_yaml.py" "$@"
