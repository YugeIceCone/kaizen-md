#!/usr/bin/env bash
# kaizen-detect-stack — mechanical stack detection → .agents/stack-context.md.
# Symlinked to ~/.local/bin/kaizen-detect-stack by /kaizen:setup.
set -euo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/scripts/util/detect_stack.py" "$@"
