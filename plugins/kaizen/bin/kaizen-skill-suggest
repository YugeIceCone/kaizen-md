#!/usr/bin/env bash
# kaizen-skill-suggest — match prompts to SKILL.md triggers + post-hoc miss audit.
# See scripts/util/skill_suggest.py.

set -euo pipefail
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || { echo "kaizen-skill-suggest: plugin root unresolved" >&2; exit 1; }
exec python3 "$PLUGIN_ROOT/scripts/util/skill_suggest.py" "$@"
