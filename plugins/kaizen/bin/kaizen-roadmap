#!/usr/bin/env bash
# kaizen-roadmap — render phase progress from the cwd's handoff file.
# Symlinked to ~/.local/bin/kaizen-roadmap by /kaizen:install.
#
# Subcommands: progress | next | phases | phase <N> | path
# Pass --json for structured output (progress/next/phases).

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../scripts/util/_plugin_root.sh
source "$_BIN_DIR/../scripts/util/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-roadmap: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/scripts/util/roadmap_status.py" "$@"
