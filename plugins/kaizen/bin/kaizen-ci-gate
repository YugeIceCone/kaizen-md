#!/usr/bin/env bash
# kaizen-ci-gate — run the CI-equivalent merge gate locally.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec bash "$PLUGIN_ROOT/skills/workflow/scripts/ci-gate.sh" "$@"
