#!/usr/bin/env bash
# kaizen-brain-promote — project-memory -> brain promotion flow.
# Dry-run by default; pass --apply to actually move.
# Filters: --source <project_slug>  --filter '<glob>'

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-brain-promote: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/brain_promote.py" "$@"
