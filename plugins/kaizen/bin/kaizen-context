#!/usr/bin/env bash
# Claude Code context-window state (zone: green/yellow/red).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/context.py" "$@"
