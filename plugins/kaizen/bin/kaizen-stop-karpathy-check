#!/usr/bin/env bash
# kaizen-stop-karpathy-check — periodic complexity check (Stop hook helper).
set -euo pipefail
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../scripts/util/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || { echo "kaizen-stop-karpathy-check: plugin root unresolved" >&2; exit 1; }
exec python3 "$PLUGIN_ROOT/scripts/handlers/stop_karpathy_check.py" "$@"
