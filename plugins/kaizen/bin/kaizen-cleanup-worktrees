#!/usr/bin/env bash
# kaizen-cleanup-worktrees — find + remove merged git worktrees.
# Symlinked to ~/.local/bin/kaizen-cleanup-worktrees by /kaizen:install.
#
# Default (no args) is dry-run. Pass --apply to actually remove.
# Reusable beyond the parallel-branches kit — any worktree-driven
# workflow benefits (kaizen-implementer subagent runs, /loop, etc.).

set -uo pipefail
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../scripts/util/_plugin_root.sh
source "$_BIN_DIR/../scripts/util/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-cleanup-worktrees: plugin root unresolved" >&2
    exit 1
}
exec python3 "$PLUGIN_ROOT/scripts/util/cleanup_worktrees.py" "$@"
