#!/usr/bin/env bash
# kaizen-handoff — CLI over the in-plugin handoff store.
#
# Subcommands: save | latest | list | path
# See skills/handoff/SKILL.md for the create/resume flows that use it.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-handoff: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/scripts/handoff/handoff.py" "$@"
