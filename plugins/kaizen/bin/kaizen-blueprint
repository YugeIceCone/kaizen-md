#!/usr/bin/env bash
# Thin wrapper — dispatches to scripts/util/blueprint.py.
# /kaizen:setup symlinks bin/ entries into ~/.local/bin/.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec python3 "$PLUGIN_ROOT/scripts/util/blueprint.py" "$@"
