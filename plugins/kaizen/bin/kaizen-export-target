#!/usr/bin/env bash
# kaizen-export-target — port the plugin to a sibling AI-CLI's layout.
# Strict-name alias of `kaizen-export` required by iron-law
# `bin-wrapper-per-cli`. Both exec export_target.py.

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-export-target: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/export_target.py" "$@"
