#!/usr/bin/env bash
# Auto-daemon: hash-compare + hygiene cleanups (cron-driven).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec uv run --script "$PLUGIN_ROOT/skills/workflow/scripts/daemon.py" "$@"
