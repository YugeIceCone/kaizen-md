#!/usr/bin/env bash
# Backlog CLI (list/add/start/tick/park/decision/render/verify).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/backlog.py" "$@"
