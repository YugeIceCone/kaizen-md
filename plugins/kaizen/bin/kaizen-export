#!/usr/bin/env bash
# kaizen-export — port the plugin to a sibling AI-CLI's layout.
# Symlinked to ~/.local/bin/kaizen-export by /kaizen:install.
#
# Usage:
#   kaizen-export --target codex --out ~/.codex
#   kaizen-export --target codex --out /tmp/out --dry-run --clean
#
# Backed by ${PLUGIN_ROOT}/skills/workflow/scripts/export_target.py.

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-export: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/export_target.py" "$@"
