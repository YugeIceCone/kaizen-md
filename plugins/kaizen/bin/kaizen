#!/usr/bin/env bash
# kaizen — unified CLI dispatcher (entry point for the bash loop).
#
# Thin wrapper around scripts/cli/kaizen_cli.py — the Python dispatcher
# is the SSOT. This shell wrapper resolves the plugin root (symlink-safe)
# and execs the dispatcher.
#
# Usage:
#   kaizen                       (or `kaizen list`) — list subcommands
#   kaizen <subcommand> [args]   — dispatch (zero overhead, execv)
#   kaizen list [--json]         — discovery (grouped catalog)
#   kaizen help <subcommand>     — full docstring
#   kaizen --time <sub> [args]   — dispatch + wall-clock timing
#   kaizen --trace <sub> [args]  — dispatch + kaizen-trace events
#   kaizen version               — plugin + dispatcher version
#
# Symlinked to ~/.local/bin/kaizen by /kaizen:setup install.
#
# History: prior to 2026-05-17 this was a 65-line bash dispatcher.
# Promoted to a Python entry point for testability + grouped
# discovery + timing/trace hooks. Subcommand resolution unchanged:
# `kaizen <X>` still routes to `${BIN_DIR}/kaizen-<X>`.

set -uo pipefail

_resolve() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
    else
        python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "$1"
    fi
}

SCRIPT_PATH=$(_resolve "${BASH_SOURCE[0]:-$0}")
BIN_DIR=$(dirname "$SCRIPT_PATH")
PLUGIN_ROOT=$(cd "$BIN_DIR/.." && pwd)

exec python3 "$PLUGIN_ROOT/scripts/cli/kaizen_cli.py" "$@"
