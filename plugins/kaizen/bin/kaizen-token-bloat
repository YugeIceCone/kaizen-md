#!/usr/bin/env bash
# Scan everything Claude sees for token bloat. Subcommands: scan | report | surface.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/scripts/index/token_bloat.py" "$@"
