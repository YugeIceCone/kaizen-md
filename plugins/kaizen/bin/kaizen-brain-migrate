#!/usr/bin/env bash
# kaizen-brain-migrate — relocate the Second Brain from ~/.claude/brain
# to ~/.claude/.kaizen/brain. See `kaizen-brain-migrate --help`.

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-brain-migrate: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/brain_migrate.py" "$@"
