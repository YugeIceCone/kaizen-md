#!/usr/bin/env bash
# kaizen-brain-audit — end-of-session discovery audit.
# Scans inbox + commits + drafts + loop-state for non-obvious learnings.
# Dry-run by default; --apply writes drafts to <brain>/Inbox/.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-brain-audit: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/brain_audit.py" "$@"
