#!/usr/bin/env bash
# Memory ledger — catalog + status + flow over memory & continuity surfaces.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/scripts/memory_ledger/memory_ledger.py" "$@"
