#!/usr/bin/env bash
# Utility surface tracker for plugins/kaizen/ docs (skills/commands/
# agents/root/references/domain). Symmetry with kaizen-bundle.
# Distinct from kaizen-docs (which generates per-package docs via docs_gen).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/plugin_docs.py" "$@"
