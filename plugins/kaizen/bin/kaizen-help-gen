#!/usr/bin/env bash
# Auto-generate commands/help.md from live command frontmatter.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/help_gen.py" "$@"
