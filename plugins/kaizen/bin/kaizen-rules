#!/usr/bin/env bash
# Brain-sourced behaviour rules (deletion-allow, check-severity, custom-pattern).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/scripts/rules/rules.py" "$@"
