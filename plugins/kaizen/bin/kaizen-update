#!/usr/bin/env bash
# Single-command maintenance: git pull + refresh-cache + prune.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec bash "$PLUGIN_ROOT/skills/workflow/scripts/update.sh" "$@"
