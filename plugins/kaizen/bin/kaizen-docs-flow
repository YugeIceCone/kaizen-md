#!/usr/bin/env bash
# kaizen-docs-flow — orchestrate per-package documentation generation.
# Strict-name wrapper required by iron-law `bin-wrapper-per-cli` (one
# wrapper per CLI script). User-facing prose lives in the longer-form
# `kaizen-docs` wrapper; both exec the same script tree.

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-docs-flow: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/docs_flow.py" "$@"
