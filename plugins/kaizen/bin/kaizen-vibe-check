#!/usr/bin/env bash
# Vibe-coding discipline check against staged diff. Composes with kaizen-precommit.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec bash "$PLUGIN_ROOT/scripts/ops/vibe_check.sh" "$@"
