#!/usr/bin/env bash
# kaizen-shim — operate on a shim-and-sweep refactor.
# Symlinked to ~/.local/bin/kaizen-shim by /kaizen:install.
#
# Backed by ${PLUGIN_ROOT}/skills/workflow/scripts/shim.py. See
# `kaizen-shim --help` for subcommands.
#
# Pairs with the shim-and-sweep routine + skill:
#   /workflow schema=shim-and-sweep
#   kaizen:shim-and-sweep skill

set -euo pipefail

# Resolve real script location through any symlinks so $_BIN_DIR points at
# the actual plugin bin dir, not ~/.local/bin/ (where /kaizen:install drops
# the symlink). Without realpath resolution, the ../skills/... source fails.
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-shim: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/shim.py" "$@"
