#!/usr/bin/env bash
# Read-side CLI for the custom-observer events.jsonl sink.
# Distinct from kaizen-observe (the 6-layer observability tool).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec python3 "$PLUGIN_ROOT/scripts/observe/observer_events.py" "$@"
