#!/usr/bin/env bash
# Session-folder management for .kaizen/superpowers/.
# Convention: <YYYY-MM-DD>-<project>-<short-sid>/multiple-files.md
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec python3 "$PLUGIN_ROOT/scripts/util/superpower_bundle.py" "$@"
