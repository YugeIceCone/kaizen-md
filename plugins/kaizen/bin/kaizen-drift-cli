#!/usr/bin/env bash
# kaizen-drift-cli — strict-name alias of kaizen-drift required by iron-law
# `bin-wrapper-per-cli`. Both exec drift_cli.py.

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-drift-cli: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/drift_cli.py" "$@"
