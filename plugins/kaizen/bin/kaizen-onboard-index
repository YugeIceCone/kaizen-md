#!/usr/bin/env bash
# kaizen-onboard-index — semantic search over the project codebase.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec uv run --script "$PLUGIN_ROOT/scripts/indexers/onboard_index.py" "$@"
