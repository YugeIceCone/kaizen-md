#!/usr/bin/env bash
# kaizen-state — read-only JSON aggregator over kaizen state files.
set -euo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/scripts/state/state.py" "$@"
