#!/usr/bin/env bash
# kaizen-brain — capture / detect / path / status for the kaizen Second Brain.
# Symlinked to ~/.local/bin/kaizen-brain by /kaizen:install.
#
# Backed by ${PLUGIN_ROOT}/scripts/brain/brain.py. Subcommands:
#   capture <text>   — classify, journal, route, write
#   detect <text>    — show inferred type without writing
#   path             — print resolved brain + project-memory paths
#   status           — file counts per brain subdir
#
# Fold-in B2 — Python port of the retired remember plugin's capture
# pipeline. Drives a PocketFlow AsyncNode graph (skills/workflow/scripts/flow.py)
# end-to-end. Schema in skills/brain/domain/.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-brain: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

# EXPLICIT uv-dispatch for verbs that need the heavy-dep venv
# (numpy + sentence-transformers + torch). In-process importlib in
# brain.py would silently bypass the PEP-723 shebang on brain_index.py
# — we'd fall back to LIKE-only search without anyone noticing.
# Route here, not there, so the user-visible bin always gets the right
# Python env. Other verbs (capture/detect/path/status/audit/promote/
# migrate) stay on plain python3 — no heavy deps needed.
case "${1:-}" in
    index|evolve)
        # `kaizen-brain index ...`  → uv run --script scripts/indexers/build_index.py ...
        # `kaizen-brain evolve ...` → uv run --script scripts/brain/brain_evolve.py ...
        # Both need the heavy-dep venv (numpy + sentence-transformers).
        # In-process importlib in brain.py would silently bypass the
        # PEP-723 shebang — we'd fall back to LIKE-only search without
        # anyone noticing. Route here, not there, so the user-visible
        # bin always gets the right Python env.
        verb="$1"; shift
        case "$verb" in
            index)  script="$PLUGIN_ROOT/scripts/indexers/build_index.py" ;;
            evolve) script="$PLUGIN_ROOT/scripts/brain/brain_evolve.py" ;;
        esac
        if command -v uv >/dev/null 2>&1; then
            exec uv run --script "$script" "$@"
        else
            echo "kaizen-brain: uv not on PATH — install via: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
            echo "kaizen-brain: falling back to plain python3 (semantic search may be LIKE-only)" >&2
            exec python3 "$script" "$@"
        fi
        ;;
    *)
        exec python3 "$PLUGIN_ROOT/scripts/brain/brain.py" "$@"
        ;;
esac
