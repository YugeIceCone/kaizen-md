#!/usr/bin/env bash
# kaizen-karpathy — DEPRECATED ALIAS for kaizen-karpathy-check.
#
# Renamed 2026-05-18 for slash↔CLI parity (matches /kaizen:karpathy-check).
# The `-check` suffix originally existed on the slash only because
# `Skill(kaizen:karpathy)` occupied the un-suffixed name; the CLI now
# adopts the same suffix for consistency.
#
# Forwards every arg to the canonical bin and emits one deprecation
# warning to stderr. Will be removed in a future release.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"

echo "kaizen-karpathy: deprecated — use kaizen-karpathy-check (or /kaizen:karpathy-check) instead." >&2

exec "$_BIN_DIR/kaizen-karpathy-check" "$@"
