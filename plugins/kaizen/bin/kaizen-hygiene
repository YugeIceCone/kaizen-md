#!/usr/bin/env bash
# Hygiene checks + safe cleanups (cache/backups/inbox/rules/backlog).
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/kaizen/scripts/hygiene.py" "$@"
