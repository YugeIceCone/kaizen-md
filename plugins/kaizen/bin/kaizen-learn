#!/usr/bin/env bash
# Thin wrapper — dispatches to scripts/util/learning_log.py.
# Append-only learning + evolution log; structured problem/solution capture.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec python3 "$PLUGIN_ROOT/scripts/util/learning_log.py" "$@"
