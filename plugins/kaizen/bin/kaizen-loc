#!/usr/bin/env bash
# kaizen-loc — function-level codebase metrics + per-symbol search.
# Symlinked to ~/.local/bin/kaizen-loc by /kaizen:install.
#
# Backed by ${PLUGIN_ROOT}/skills/workflow/scripts/loc_index.py. See
# `kaizen-loc --help` for subcommands (index / search / files / show /
# report / stats / get / path / clear).
#
# Phase 1 X1 — Python port of shodan's xtask/src/loc.rs. Per-repo SQLite
# index at <repo>/.kaizen/loc.db.

set -euo pipefail

# Resolve real script location through any symlinks so $_BIN_DIR points at
# the actual plugin bin dir, not ~/.local/bin/ (where /kaizen:install drops
# the symlink). Without realpath resolution, the ../skills/... source fails.
_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-loc: plugin root unresolved — set CLAUDE_PLUGIN_ROOT or KAIZEN_PLUGIN_ROOT" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/scripts/indexers/loc_index.py" "$@"
