#!/usr/bin/env bash
# Thin wrapper — dispatches to scripts/util/progress_log.py.
# /kaizen:setup symlinks bin/ entries into ~/.local/bin/, so `kaizen-progress`
# is shell-addressable after install.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec python3 "$PLUGIN_ROOT/scripts/util/progress_log.py" "$@"
