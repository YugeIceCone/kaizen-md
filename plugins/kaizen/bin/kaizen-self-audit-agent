#!/usr/bin/env bash
# kaizen-self-audit-agent — agent-driven follow-up to the mechanical
# self-audit. Renders subagent briefs (dispatch-plan) and merges their
# results (aggregate).
#
# Subcommands: dispatch-plan [--json] | aggregate [--run-id ID] [--json] | path
# See skills/plugin-self-audit/SKILL.md for the full three-phase flow.

set -euo pipefail

_SCRIPT_REAL="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null \
  || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_BIN_DIR="$(cd "$(dirname "$_SCRIPT_REAL")" && pwd)"
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-self-audit-agent: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/self_audit_agent.py" "$@"
