#!/usr/bin/env bash
# Run the async Node+Flow demo on a workspace.
set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/flow_demo.py" "$@"
