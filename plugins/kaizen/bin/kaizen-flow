#!/usr/bin/env bash
# kaizen-flow — consolidated flow-family dispatcher.
# Dispatches:
#   kaizen-flow demo   → flow.py         (async Node+Flow reference pipeline)
#   kaizen-flow docs   → docs_flow.py    (per-package docs)
#   kaizen-flow index  → index_flow.py   (semantic-index orchestrator)
#   kaizen-flow search → search_flow.py  (semantic-search orchestrator)
# See `kaizen-flow --help` for the verb listing.

set -uo pipefail
SCRIPT=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")
PLUGIN_ROOT=$(cd "$(dirname "$SCRIPT")/.." && pwd)
exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/flow_cli.py" "$@"
