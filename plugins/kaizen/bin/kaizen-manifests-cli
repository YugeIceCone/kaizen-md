#!/usr/bin/env bash
# kaizen-manifests-cli — strict-name alias of kaizen-manifests required by
# iron-law `bin-wrapper-per-cli`. Both exec manifests_cli.py.

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../skills/workflow/scripts/_plugin_root.sh
source "$_BIN_DIR/../skills/workflow/scripts/_plugin_root.sh"
PLUGIN_ROOT="$(kaizen_plugin_root)" || {
    echo "kaizen-manifests-cli: plugin root unresolved" >&2
    exit 1
}

exec python3 "$PLUGIN_ROOT/skills/workflow/scripts/manifests_cli.py" "$@"
