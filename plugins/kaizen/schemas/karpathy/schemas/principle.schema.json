{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen.invalid/karpathy/schemas/principle.schema.json",
  "title": "Karpathy principles catalog",
  "description": "Validates schemas/karpathy/principles.yaml — the canonical declarative form of Karpathy's 4 coding principles.",
  "type": "object",
  "required": ["principles"],
  "additionalProperties": true,
  "properties": {
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Principle" }
    },
    "relax_when": { "type": "array", "items": { "type": "string" } },
    "enforce_when": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "Principle": {
      "type": "object",
      "required": ["id", "number", "title", "rule", "duties", "test"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "number": { "type": "integer", "minimum": 1, "maximum": 4 },
        "title": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "scanner": {
          "type": "string",
          "pattern": "^[a-z_]+\\.py$",
          "description": "Filename of the matching scanner in skills/karpathy/scripts/"
        },
        "duties": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "test": { "type": "string" },
        "anti_patterns": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "pairs_with": { "type": "array", "items": { "type": "string" } },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
