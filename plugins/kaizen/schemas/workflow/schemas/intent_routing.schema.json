{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen.invalid/schemas/intent_routing.schema.json",
  "title": "Kaizen intent routing catalog",
  "description": "Validates schemas/workflow/intent_routing.yaml — the single source of truth for the code-router skill.",
  "type": "object",
  "required": ["routes", "disambiguation", "composition", "limits", "elsewhere", "invocation_protocol"],
  "additionalProperties": false,
  "properties": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Route" }
    },
    "disambiguation": {
      "type": "array",
      "items": { "$ref": "#/$defs/Disambiguation" }
    },
    "composition": {
      "type": "array",
      "items": { "$ref": "#/$defs/Composition" }
    },
    "limits": { "$ref": "#/$defs/Limits" },
    "elsewhere": {
      "type": "array",
      "items": { "$ref": "#/$defs/Elsewhere" }
    },
    "invocation_protocol": {
      "type": "string",
      "minLength": 1,
      "description": "Numbered prose describing how a caller (or downstream skill) should consume the routes table."
    }
  },
  "$defs": {
    "Route": {
      "type": "object",
      "required": ["id", "skill", "intent", "cues"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "kebab-case identifier; matches the principle skill leaf-name without the coding-skills: prefix"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$",
          "description": "Fully-qualified `<plugin>:<skill>` identifier (e.g. coding-skills:yagni)"
        },
        "intent": {
          "type": "string",
          "minLength": 4,
          "description": "One-line plain-English purpose"
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 },
          "description": "Trigger phrases. Matcher is substring (case-insensitive) by default."
        }
      }
    },
    "Disambiguation": {
      "type": "object",
      "required": ["pair", "rule"],
      "additionalProperties": false,
      "properties": {
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Two route ids that overlap in practice"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "Tiebreaker prose; resolver shows this to the agent."
        },
        "examples": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "Composition": {
      "type": "object",
      "required": ["prompt_shape", "sequence"],
      "additionalProperties": false,
      "properties": {
        "prompt_shape": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string" },
          "description": "Ordered list of route ids to invoke. NEVER simultaneously — caller advances when previous returns."
        },
        "fallback_second": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Alternative route ids for the SECOND slot when the canonical sequence's tail doesn't fit. Optional."
        },
        "notes": { "type": "string" }
      }
    },
    "Limits": {
      "type": "object",
      "required": ["max_skills_per_turn"],
      "additionalProperties": false,
      "properties": {
        "max_skills_per_turn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "notes": { "type": "string" }
      }
    },
    "Elsewhere": {
      "type": "object",
      "required": ["intent"],
      "additionalProperties": false,
      "properties": {
        "intent": { "type": "string", "minLength": 1 },
        "route_to": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
            { "type": "null" }
          ],
          "description": "Skill name to redirect to, or null when no skill is load-bearing for this intent (caller just answers directly)."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
