{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YugeIceCone/kaizen-md/skills/intent/list-out.schema.json",
  "title": "kaizen-intent list output",
  "type": "object",
  "required": ["intents", "count"],
  "additionalProperties": false,
  "properties": {
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id":             { "type": "string" },
          "description":    { "type": "string" },
          "trigger_kinds":  { "type": "array", "items": { "type": "string" } },
          "confidence":     { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "count": { "type": "integer", "minimum": 0 }
  }
}
