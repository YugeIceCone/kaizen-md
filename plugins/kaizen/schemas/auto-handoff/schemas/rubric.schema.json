{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kaizen-auto-handoff-rubric",
  "title": "kaizen auto-handoff rubric (BucketWalker)",
  "description": "Rules walked by schema_cli.BucketWalker. First match wins. Bucket → action mapping lives in config.yaml::on_bucket.",
  "type": "object",
  "required": ["version", "rules", "fallback"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bucket"],
        "additionalProperties": false,
        "properties": {
          "bucket": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "require_all": { "$ref": "#/definitions/condition_list" },
          "require_any": { "$ref": "#/definitions/condition_list" }
        }
      }
    },
    "confidence_threshold": {
      "type": "number", "minimum": 0, "maximum": 1
    },
    "fallback": { "type": "string" }
  },
  "definitions": {
    "condition_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal", "op", "value"],
        "additionalProperties": false,
        "properties": {
          "signal": {
            "type": "string",
            "enum": ["pct", "threshold", "above_threshold",
                      "compact_count", "peak_pct", "threshold_delta"]
          },
          "op": {
            "enum": [">=", ">", "<=", "<", "==", "!="]
          },
          "value": { "type": "number" }
        }
      }
    }
  }
}
