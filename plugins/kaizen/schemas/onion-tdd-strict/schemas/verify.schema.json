{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen.invalid/schemas/onion-tdd-strict/verify.schema.json",
  "title": "Onion-DDD verification commands",
  "description": "Per-claim verification commands the onion-tdd-strict routine's verify stage runs. Each claim's checks return exit 0 (claim holds) or non-zero (violated). Compiler is not a substitute.",
  "type": "object",
  "required": ["version", "claims"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Claim" }
    },
    "lint_rule_families": {
      "type": "array",
      "items": { "$ref": "#/$defs/LintFamily" }
    },
    "lint_hygiene": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "required": ["id", "description", "severity", "checks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "checks": {
          "type": "object",
          "description": "Map of stack/category → shell snippet. Keys include language stacks (rust, go, node, typescript, python, java) plus categories (shell, manual, grep_port_defined, grep_impl_exists).",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "LintFamily": {
      "type": "object",
      "required": ["id", "description", "naming_pattern", "tooling"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "naming_pattern": {
          "type": "string",
          "description": "Suggested rule-id pattern, e.g. 'onion-no-<dep>-in-<layer>'."
        },
        "tooling": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    }
  }
}
