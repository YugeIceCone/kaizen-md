{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YugeIceCone/kaizen-md/skills/deus-ex-machina/tail-out.schema.json",
  "title": "deus-ex-machina tail output",
  "type": "object",
  "required": ["session_id", "events", "count"],
  "properties": {
    "session_id": { "type": "string" },
    "events":     { "type": "array", "items": { "$ref": "#/$defs/Event" } },
    "count":      { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "Event": {
      "type": "object",
      "required": ["ts_unix", "session_id", "evt_type"],
      "additionalProperties": true,
      "properties": {
        "ts_unix":      { "type": "number" },
        "session_id":   { "type": "string" },
        "evt_type":     { "type": "string" },
        "tool_name":    { "type": "string" },
        "tool_use_id":  { "type": "string" },
        "duration_ms":  { "type": "number" },
        "exit_code":    { "type": "integer" },
        "command":      { "type": "string" }
      }
    }
  }
}
