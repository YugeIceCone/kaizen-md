{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YugeIceCone/kaizen-md/skills/deus-ex-machina/replay-out.schema.json",
  "title": "deus-ex-machina replay output",
  "type": "object",
  "required": ["session_id", "source_jsonl", "events_path", "synthesized_count", "truncated"],
  "additionalProperties": false,
  "properties": {
    "session_id":        { "type": "string" },
    "source_jsonl":      { "type": "string" },
    "events_path":       { "type": "string" },
    "synthesized_count": { "type": "integer", "minimum": 0 },
    "truncated":         { "type": "boolean" }
  }
}
