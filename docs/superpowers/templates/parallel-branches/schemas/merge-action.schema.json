{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen-md/templates/parallel-branches/merge-action.schema.json",
  "title": "MERGE-step action",
  "description": "One action in the merge step's actions[] list. Each is run sequentially by the parent orchestrator after all chunks finish. Handlers are predefined; adding a new merge capability = add to this enum + register a handler.",
  "oneOf": [
    {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"enum": [
          "consolidate_perms",
          "append_progress",
          "dispatch_backlog",
          "wire_mcp_mounts",
          "cleanup_fragments",
          "merge_commit",
          "final_verify"
        ]}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["action", "targets"],
      "properties": {
        "action":  {"const": "retrofit"},
        "targets": {"type": "array", "items": {"type": "string"}, "description": "Axis names to retrofit from standalone Python to YAML axis_runner form"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["action", "to_project", "axes"],
      "properties": {
        "action":     {"const": "cross_pollinate"},
        "to_project": {"type": "string"},
        "axes":       {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    {
      "type": "string",
      "enum": [
        "consolidate_perms",
        "append_progress",
        "dispatch_backlog",
        "wire_mcp_mounts",
        "cleanup_fragments",
        "merge_commit",
        "final_verify"
      ],
      "description": "Shorthand form — string == {\"action\": <string>}"
    }
  ]
}
