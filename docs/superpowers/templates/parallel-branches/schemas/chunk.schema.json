{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen-md/templates/parallel-branches/chunk.schema.json",
  "title": "Single chunk file (Mode B split layout)",
  "description": "When a master plan declares `chunks: \"./chunks/*.yaml\"` (Mode B), each matched file is one chunk validated against this schema. Same shape as the inline chunk definition in master-plan.schema.json#/$defs/chunk, just promoted to a standalone document so a chunk file can be edited/validated/templated independently.",
  "type": "object",
  "required": ["id", "title", "purpose", "project", "deps", "subagent", "isolation", "budget_tokens", "owns", "fragments", "tasks"],
  "properties": {
    "id":            {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "title":         {"type": "string"},
    "purpose":       {"type": "string"},
    "project":       {"type": "string"},
    "deps":          {"type": "array", "items": {"type": "string"}},
    "subagent":      {"enum": ["kaizen-implementer", "general-purpose", "Explore", "Plan", "parent"]},
    "isolation":     {"enum": ["worktree", "none"]},
    "worktree_branch": {"type": "string"},
    "budget_tokens": {"type": "integer", "minimum": 20000, "maximum": 40000},
    "owns": {
      "type": "object",
      "required": ["scripts", "tests", "bins", "fragment_dir"],
      "properties": {
        "scripts":      {"type": "array", "items": {"type": "string"}},
        "tests":        {"type": "array", "items": {"type": "string"}},
        "bins":         {"type": "array", "items": {"type": "string"}},
        "fragment_dir": {"type": "string", "pattern": "^\\.chunks/.+/$"},
        "other":        {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "fragments":     {"type": "array", "items": {"enum": ["perms.json", "progress.md", "backlog.jsonl", "mcp-mounts.txt"]}},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "commit_message"],
        "properties": {
          "id":               {"type": "string"},
          "brainstorm_ref":   {"type": "string"},
          "description":      {"type": "string"},
          "red_test_snippet": {"type": "string"},
          "green_outline":    {"type": "string"},
          "commit_message":   {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "guide": {
      "type": "object",
      "properties": {
        "working_dir":        {"type": "string"},
        "skills_to_load":     {"type": "array", "items": {"type": "string"}},
        "exemplar_files":     {"type": "array", "items": {"type": "string"}},
        "conventions":        {"type": "array", "items": {"type": "string"}},
        "upstream_decisions": {"type": "array", "items": {"type": "string"}},
        "do_not_touch":       {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "$template": {"type": "string", "description": "Optional — name of a chunks-library template this file extends (deferred to v2)"},
    "vars":      {"type": "object", "description": "Variable bindings when using $template (deferred to v2)"}
  },
  "additionalProperties": false
}
