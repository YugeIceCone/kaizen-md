{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaizen-md/templates/parallel-branches/backlog-fragment.schema.json",
  "title": "Backlog-item fragment row",
  "description": "One row per backlog-add request, JSONL format. Written to .chunks/<chunk_id>/backlog.jsonl. MERGE step dispatches each row through `kaizen backlog add` CLI (single-writer to .kaizen/workflow/backlog.json).",
  "type": "object",
  "required": ["title", "probe", "verify", "section"],
  "properties": {
    "title":   {"type": "string", "minLength": 5},
    "probe":   {"type": "string", "minLength": 10},
    "verify":  {"type": "string", "minLength": 10},
    "section": {"enum": ["in_flight", "next_up", "done", "parked"]},
    "ref":     {"type": "string", "description": "Source spec/plan/doc path"},
    "tags":    {"type": "string", "description": "Comma-separated tag list"}
  },
  "additionalProperties": false
}
