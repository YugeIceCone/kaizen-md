# Editor / OS noise
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Runtime artifacts (not source)
node_modules/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local install state
plugins/*/CACHE/

# Stray .kaizen/ written by subagents run with cwd inside a plugin dir;
# the real workflow dir is the repo-root .kaizen/
plugins/**/.kaizen/

# Test sandboxes (the test script auto-cleans, but if --keep is used)
gwtest-*/

# Timestamped backups from migrators (brain_migrate, path_migrate,
# settings.json edits). Format: <name>.bak-<UTC>.<ext> or similar.
*.bak-*
*.bak.[0-9]*

# Audit reports under `.kaizen/workflow/audits/` are excluded via
# the per-dir `.kaizen/.gitignore` (re-ignores under the broad
# workflow/** whitelist there). Kept local to avoid double-rules.
