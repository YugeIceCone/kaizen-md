# Editor / OS noise
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Runtime artifacts (not source)
node_modules/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local install state
plugins/*/CACHE/

# Stray .kaizen/ written by subagents run with cwd inside a plugin dir;
# the real workflow dir is the repo-root .kaizen/
plugins/**/.kaizen/

# Test sandboxes (the test script auto-cleans, but if --keep is used)
gwtest-*/

# Timestamped backups from migrators (brain_migrate, path_migrate,
# settings.json edits). Format: <name>.bak-<UTC>.<ext> or similar.
*.bak-*
*.bak.[0-9]*

# Audit reports under `.kaizen/workflow/audits/` are excluded via
# the per-dir `.kaizen/.gitignore` (re-ignores under the broad
# workflow/** whitelist there). Kept local to avoid double-rules.

# docs/ — per-author session-bundle working content (managed by
# kaizen-bundle). Each project gets its own docs/superpowers/ via the
# plugin's `_superpowers_dir()` default (cwd/docs/superpowers), so we
# don't ship the kaizen-md author's bundles to plugin consumers.
# The nested `docs/superpowers/.git` (managed via kaizen-bundle git-init)
# is the system-of-record for these bundles — push it to its own remote
# if you want them shareable separately from the parent repo.
docs/

# Tool-scratch dirs dropped by external tooling (IDE / FleetView stack
# context, kaizen-implementer subagent worktree metadata). Never plugin
# content.
.agents/
.claude/
