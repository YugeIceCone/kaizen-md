# Editor / OS noise
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Runtime artifacts (not source)
node_modules/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local install state
plugins/*/CACHE/

# Stray .kaizen/ written by subagents run with cwd inside a plugin dir;
# the real workflow dir is the repo-root .kaizen/
plugins/**/.kaizen/

# Test sandboxes (the test script auto-cleans, but if --keep is used)
gwtest-*/

# Timestamped backups from migrators (brain_migrate, path_migrate,
# settings.json edits). Format: <name>.bak-<UTC>.<ext> or similar.
*.bak-*
*.bak.[0-9]*

# kaizen audit reports — auto-regenerated session artifacts.
# Already-tracked reports stay tracked (git ignores ignore rules for
# tracked files); only new reports are excluded.
.kaizen/workflow/audits/*.md
